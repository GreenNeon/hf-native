# HiFeed API Base URL
# Di Expo SDK 57, variabel lingkungan yang diakses di aplikasi client harus diawali dengan EXPO_PUBLIC_
# Contoh:
# - HP Fisik via Wi-Fi LAN: http://192.168.1.71:3000
# - Android Emulator (Host loopback): http://10.0.2.2:3000
# - iOS Simulator / Web: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.71:3000
